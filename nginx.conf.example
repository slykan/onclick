# Primjer nginx server bloka za on-click.hr (static export)
# Kopirati u /etc/nginx/sites-available/on-click.hr na VPS-u,
# prilagoditi putanju do `out/` folderu, pa:
#   ln -s /etc/nginx/sites-available/on-click.hr /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx
# SSL certifikat: certbot --nginx -d on-click.hr -d www.on-click.hr

server {
    listen 80;
    server_name on-click.hr www.on-click.hr;

    root /home/onclick/onclick/out;
    index index.html;

    # Stari Joomla URL-ovi -> novi (SEO kontinuitet)
    location = /our-services { return 301 /usluge; }
    location = /contact { return 301 /kontakt; }

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;

    location ~* \.(js|css|woff2?|svg|jpg|jpeg|png)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
